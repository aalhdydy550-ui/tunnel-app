<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Per-app proxy screen: listing the installed apps needs full
         package visibility on Android 11+ — without it
         PackageManager returns only a filtered subset. This is the
         core function of the per-app proxy (a VPN feature); the list
         never leaves the device and no app data is collected. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application>
        <!-- The VPN service: one foreground service, one TUN, one core.
             Runs in the main process (no android:process). -->
        <service
            android:name=".TunnelVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Required for the specialUse type (API 34+): the use case is
                 reviewed in the Play Console — a VPN tunnel has no dedicated
                 foreground-service type, so it declares itself here. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- Proxy-only mode (item 5a): a plain foreground service,
             NOT a VpnService — no BIND_VPN_SERVICE permission, no
             android.net.VpnService intent-filter, no system VPN
             consent dialog. It runs the same sing-box core with a
             config that has no tun inbound, so it only serves the
             local mixed proxy (127.0.0.1:10808). specialUse has no
             dedicated type on Android 14; revisit on F-Droid/Play
             publication. -->
        <service
            android:name=".ProxyOnlyService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/app_name">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="proxy" />
        </service>

        <!-- Auto-restart on boot (opt-in; see BootReceiver). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings tile (batch 1, item #2): one tap toggles
             the tunnel from any screen. The user adds it from the QS
             panel editor; the system binds it (BIND_QUICK_SETTINGS_TILE).
             State comes from TunnelStateHolder, read-only — see
             TunnelTileService. -->
        <service
            android:name=".TunnelTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
